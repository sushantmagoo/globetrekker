{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}
}

globetrekker.me {
	import security_headers
	encode zstd gzip

	header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"

	# Link-preview crawlers get server-rendered Open Graph HTML.
	@crawlers {
		path /j/* /u/*
		header_regexp User-Agent (?i)(bot|crawler|spider|facebookexternalhit|slackbot|twitterbot|whatsapp|telegrambot|discordbot|linkedinbot|embedly|pinterest)
	}
	handle @crawlers {
		rewrite * /api/v1/og{uri}
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /sitemap.xml {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}

www.globetrekker.me {
	redir https://globetrekker.me{uri} permanent
}
