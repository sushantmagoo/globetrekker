# Copy to .env and fill in. Local dev works with the defaults; prod REQUIRES the secrets below.

APP_ENV=local

# --- Postgres ---
POSTGRES_USER=globetrekker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=globetrekker

# --- Auth --- (generate with: openssl rand -hex 32)
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- App URL ---
PUBLIC_APP_URL=http://localhost:5173

# --- Prod only ---
ACME_EMAIL=admin@globetrekker.me
WEB_CONCURRENCY=4
SENTRY_DSN=
